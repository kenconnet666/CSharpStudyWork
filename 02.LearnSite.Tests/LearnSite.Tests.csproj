<Project Sdk="Microsoft.NET.Sdk">

    <!-- 单元测试：只测 02.LearnSite.Core 里的纯逻辑，不连设备、不连数据库。xunit v3 的测试项目是可执行程序 -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>LearnSite.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="xunit.v3" Version="4.0.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../02.LearnSite.Core/LearnSite.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
