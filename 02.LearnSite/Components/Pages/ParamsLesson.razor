@page "/params"
@inherits RuneComponent

@*
    第 4 课：参数传递——默认、ref、out。
      演示 1：单步回放。左边调用方的 n，右边方法里的 p，一步一步看值是"复制"还是"共用同一个盒子"
      演示 2：交换两个数。不写 ref 交换不了，写了 ref 才行；再用 int.TryParse 看 out 的真实用法
    对应 01.CSharpSyntax 的第 2 课（RefOutIn）。
*@

<LessonPage Title="参数传递：默认、ref、out">
    <Intro>
        把变量交给方法时，方法拿到的是什么？默认是<strong>一份复印件</strong>。想让方法真的改到你的变量，要用
        <Code>ref</Code>；想让方法把结果"送回来"，用 <Code>out</Code>。Java 里没有这两个关键字，是 C# 的一个特色。
    </Intro>
    <ChildContent>
        <Card>
            <Header><Strong>演示 1：单步回放</Strong></Header>
            <ChildContent>
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Lg">
                    <ToggleGroup @bind-Value="mode" Required="true" aria-label="传递方式">
                        <ToggleItem Value="value">默认（按值）</ToggleItem>
                        <ToggleItem Value="ref">ref</ToggleItem>
                        <ToggleItem Value="out">out</ToggleItem>
                    </ToggleGroup>
                    <ParamFlow Mode="@mode" />
                    <Quiz Question="用默认方式调用 Add10(n)，方法里 p += 10，之后 n 是多少？" Options="@(new[] { "1", "11" })" Answer="0"
                          Explain="默认是按值传递，p 是 n 的复印件，改复印件不影响原件，n 仍是 1。" />
                </Flex>
            </ChildContent>
        </Card>

        <Demo Title="演示 2：交换两个数（ref 的经典用法）">
            <Stage>
                <Flex Gap="SpaceScale.Lg" Align="ItemAlign.Center" Wrap="true">
                    <Slot Name="a" Data="@a.ToString()" Changed="@swapped" />
                    <span aria-hidden="true">⇄</span>
                    <Slot Name="b" Data="@b.ToString()" Changed="@swapped" />
                </Flex>
                <Flex Gap="SpaceScale.Sm" Wrap="true">
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="SwapByValue">Swap(a, b)　不写 ref</Button>
                    <Button Icon="Lucide.Repeat" @onclick="SwapByRef">Swap(ref a, ref b)</Button>
                    <Button Variant="ButtonVariant.Ghost" Tone="Tone.Neutral" @onclick="ResetSwap">重来</Button>
                </Flex>
                <Narration @key="@swapNote" Emoji="@(swapNote.Contains('✅') ? "🔁" : "🙅")">@swapNote</Narration>
            </Stage>
            <Side>
                <CodeBlock Code="@SwapCode" Lang="csharp" Copyable="false" />
            </Side>
        </Demo>

        <Demo Title="演示 3：out 的真实用法——TryParse">
            <Stage>
                <Field Label="输入一段文字，试试能不能变成整数">
                    <TextField @bind-Value="text" />
                </Field>
                <Flex Gap="SpaceScale.Sm" Wrap="true">
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => text = "42")">42</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => text = "abc")">abc</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => text = "3.14")">3.14</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => text = "")">（空）</Button>
                </Flex>
                <Grid MinItemWidth="CssLength.Rem(16)" Gap="SpaceScale.Sm">
                    <Readout Title="int.TryParse(text, out var n)" Value="@TryParseResult" />
                    <Readout Title="int.Parse(text)" Value="@ParseResult" />
                </Grid>
            </Stage>
            <Side>
                <CodeBlock Code="@TryParseCode" Lang="csharp" Copyable="false" />
                <Narration Emoji="🧯">
                    <Code>TryParse</Code> 用<strong>返回值</strong>告诉你成不成功，用 <Code>out</Code> 参数把<strong>结果</strong>送出来，失败时不抛异常，
                    所以解析用户输入、串口收到的文本，一律用它；<Code>int.Parse</Code> 遇到不能解析的文字会直接抛异常。
                </Narration>
                <Quiz Question="调用 int.TryParse(text, out var n) 之前，n 需要先赋值吗？" Options="@(new[] { "需要", "不需要" })" Answer="1"
                      Explain="out 参数在调用前可以没有值，方法保证在返回前给它赋值（失败时赋的是 0）。这正是 out 和 ref 最大的区别。" />
            </Side>
        </Demo>

        <Prose Measure="false">
            <H2>四种方式对比</H2>
            <table>
                <thead>
                    <tr><th>写法</th><th>调用前要有值？</th><th>方法内必须赋值？</th><th>能改到调用方的变量？</th><th>典型用途</th></tr>
                </thead>
                <tbody>
                    <tr><td>默认</td><td>是</td><td>否</td><td>不能（改的是副本）</td><td>绝大多数参数</td></tr>
                    <tr><td><Code>ref</Code></td><td>是</td><td>否</td><td>能</td><td>交换、原地修改</td></tr>
                    <tr><td><Code>out</Code></td><td>否</td><td>是</td><td>能（送回结果）</td><td><Code>TryParse</Code>、一次返回多个值</td></tr>
                    <tr><td><Code>in</Code></td><td>是</td><td>否</td><td>不能（只读）</td><td>传很大的 struct，避免复制</td></tr>
                </tbody>
            </table>
            <H2>别混淆的一点</H2>
            <Paragraph>
                传<strong>引用类型</strong>（如 <Code>List&lt;int&gt;</Code>）时，默认复制的是"引用"（那根箭头），所以方法里 <Code>list.Add(1)</Code> 调用方看得到——
                它们指向同一个对象（上一课的内容）。但方法里 <Code>list = new List&lt;int&gt;()</Code> 只是让副本箭头指向了新对象，调用方的变量不受影响；
                想连变量本身都换掉，同样要用 <Code>ref</Code>。
            </Paragraph>
        </Prose>
    </ChildContent>
</LessonPage>

@code {
    // ---- 演示 1 ----
    string mode = "value";

    // ---- 演示 2：交换 ----
    int a = 1;
    int b = 2;
    bool swapped;
    string swapNote = "👆 两种调用都试试，看 a、b 有没有变。";
    string swapCode = "";

    string SwapCode => string.Join("\n",
        "static void Swap(int x, int y)          { (x, y) = (y, x); }   // 不写 ref：交换的是两个副本",
        "static void Swap(ref int x, ref int y)  { (x, y) = (y, x); }   // 写了 ref：交换的就是 a 和 b 本身",
        $"int a = {(swapped ? 2 : 1)}, b = {(swapped ? 1 : 2)};{swapCode}");

    void SwapByValue()
    {
        swapCode = "\nSwap(a, b);        // a、b 没变";
        swapNote = "🙅 没有交换：x、y 是 a、b 的复印件，方法里换的是复印件，用完就丢，a 和 b 原封不动。";
    }

    void SwapByRef()
    {
        (a, b) = (b, a);
        swapped = !swapped;
        swapCode = "\nSwap(ref a, ref b);   // a、b 真的换了";
        swapNote = "✅ 交换成功：ref 让 x、y 成为 a、b 的别名，方法里换 x、y 就是在换 a、b。再点一次会换回来。";
    }

    void ResetSwap()
    {
        a = 1;
        b = 2;
        swapped = false;
        swapCode = "";
        swapNote = "👆 两种调用都试试，看 a、b 有没有变。";
    }

    // ---- 演示 3：TryParse ----
    string text = "42";

    string TryParseResult => int.TryParse(text, out var n) ? $"返回 true，n = {n}" : $"返回 false，n = {n}";

    string ParseResult
    {
        get
        {
            try
            {
                return $"返回 {int.Parse(text)}";
            }
            catch (Exception ex)
            {
                return $"抛出 {ex.GetType().Name}";
            }
        }
    }

    string TryParseCode => $"bool ok = int.TryParse(\"{text}\", out var n);   // ok = {(int.TryParse(text, out var n) ? "true" : "false")}, n = {n}\nvar value = int.Parse(\"{text}\");               // {ParseResult}";
}
