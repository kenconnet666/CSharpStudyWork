@page "/polling"
@implements IDisposable
@inherits RuneComponent

@*
    通信 7：上位机通信的整体结构——轮询、超时、断线重连。
    把前面学的东西串起来：真正跑在现场的上位机，大部分代码其实是在处理"通信出了问题怎么办"。
*@

<LessonPage Title="轮询、超时与断线重连：上位机通信的骨架">
    <Intro>
        前面几课学的是「怎么说话」（协议、字节、校验）。真正跑在现场的上位机，大部分代码却是在处理<strong>「对方不说话了怎么办」</strong>：
        网线被踢掉、设备断电重启、网络拥堵……一个能 7×24 小时跑的上位机，必须有<strong>周期轮询、超时、重试、断线重连</strong>这套骨架。
    </Intro>
    <ChildContent>
        <ConceptGuide>
            <Concept Term="轮询周期" Analogy="保安每隔 10 分钟巡一次楼：太频繁累死人，太稀疏会漏事。">
                Modbus 是主从结构，设备不会主动上报，所以上位机要<strong>每隔一段时间读一次</strong>。周期由点位变化速度和通信带宽决定，常见 200 毫秒~1 秒。
            </Concept>
            <Concept Term="超时" Analogy="打电话没人接，响 30 秒就该挂了，不能一直握着听筒等。">
                任何网络读写都<strong>必须设超时</strong>，否则设备掉线后线程会永久挂起。超时通常设为「正常响应时间的 3~5 倍」，比如正常 100 毫秒，超时设 500~1000 毫秒。
            </Concept>
            <Concept Term="连续失败计数与重连" Analogy="偶尔一次没接通不算什么，连续三次打不通，就该怀疑号码或电话线有问题了。">
                一次超时可能只是网络抖动，所以<strong>连续失败 N 次</strong>才判定「断线」，然后关闭旧连接、重新连接。不要一超时就重连，否则会把正常的设备折腾得更糟。
            </Concept>
            <Concept Term="退避（backoff）" Analogy="敲门没人开，不要一直砸，隔 1 秒、2 秒、4 秒……越来越久再敲。">
                重连失败时，等待时间<strong>逐次变长</strong>（1、2、4、8 秒，设一个上限），避免对着一台正在重启的设备疯狂连接，浪费 CPU 和网络。
            </Concept>
            <Concept Term="通信与界面分开" Analogy="后厨和前台分开：后厨忙着炒菜（通信），前台只看出菜口的显示屏（界面）。">
                通信在<strong>后台任务</strong>里循环；读到的数据放进共享的最新值或 <Code>Channel</Code>，界面定时取最新值显示。这样设备再慢、再掉线，界面都不会卡。
            </Concept>
        </ConceptGuide>

        <Demo Title="演示：拔掉网线，看上位机怎么应对">
            <Stage>
                <Flex Gap="SpaceScale.Sm" Wrap="true">
                    <Button Icon="@(running ? Lucide.Square : Lucide.Play)" @onclick="Toggle">@(running ? "停止轮询" : "开始轮询")</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="@(cableOk ? Tone.Danger : Tone.Success)" Icon="@(cableOk ? Lucide.Unplug : Lucide.Plug)" @onclick="ToggleCable">@(cableOk ? "拔掉网线" : "插上网线")</Button>
                </Flex>
                <Field Label="@($"超时 {timeoutMs} 毫秒（设备正常响应约 120 毫秒）")"><Slider TValue="int" @bind-Value="timeoutMs" Min="50" Max="1500" Step="50" /></Field>
                <Field Label="@($"连续失败 {maxFail} 次判定断线")"><Slider TValue="int" @bind-Value="maxFail" Min="1" Max="6" /></Field>
                <Grid MinItemWidth="CssLength.Rem(11)" Gap="SpaceScale.Sm">
                    <Slot Name="线路" Data="@(cableOk ? "正常" : "已断开")" Changed="@(!cableOk)" />
                    <Slot Name="上位机状态" Data="@state" Changed="true" />
                    <Slot Name="连续失败" Data="@fail.ToString()" />
                    <Slot Name="最新温度" Data="@(lastValue is null ? "（无）" : $"{lastValue:F1} ℃")" />
                </Grid>
                <Paragraph Tone="TextTone.Muted">超时设得比设备响应时间还短（比如 50 毫秒）会怎样？试试看：明明线路正常，却一直超时。</Paragraph>
            </Stage>
            <Side>
                <IconLabel Icon="Lucide.Terminal">通信日志</IconLabel>
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xs">
                    @if (log.Count == 0)
                    {
                        <Paragraph Tone="TextTone.Muted">（点“开始轮询”）</Paragraph>
                    }
                    @foreach (var (line, i) in log.Select((l, i) => (l, i)))
                    {
                        <Code @key="@($"{i}{line}")">@line</Code>
                    }
                </Flex>
                <Narration @key="@state" Mood="@(state == "运行中" ? "✅" : state == "已停止" ? "💡" : "🚨")">@StateNote</Narration>
            </Side>
        </Demo>

        <Demo Title="代码骨架（简化版）">
            <Stage>
                <CodeBlock Code="@LoopCode" Lang="csharp" Copyable="false" />
            </Stage>
            <Side>
                <Quiz Question="设备掉线时，上位机的读操作没有设超时，会发生什么？" Options="@(new[] { "立刻报错，自动重连", "读操作可能一直等下去，轮询线程卡住，界面数据永远不更新", "自动使用上一次的值，不影响" })" Answer="1"
                      Explain="网络读写默认可能没有超时，设备掉线后线程会一直等。所以每次读写都要带超时（CancellationTokenSource.CancelAfter 或 ReadTimeout），超时就当作一次失败处理。" />
                <Quiz Question="重连失败后，下一次重连前应该？" Options="@(new[] { "立刻再连，越快越好", "等待一段时间，并且逐次拉长（退避）", "永远不再重连" })" Answer="1"
                      Explain="立刻疯狂重连会占满 CPU 与网络，还可能让正在重启的设备更忙。逐次加倍、设一个上限的退避是通用做法。" />
            </Side>
        </Demo>

        <Prose Measure="false">
            <H2>真实项目里还要考虑</H2>
            <ul>
                <li><strong>读到值要打上时间和质量</strong>：掉线时界面应该显示「通信中断」，而不是继续显示最后一个数字让操作员误以为正常。</li>
                <li><strong>写操作要确认</strong>：写寄存器后最好读回来核对，重要的控制指令要有重试和日志。</li>
                <li><strong>一个设备一个任务</strong>：每台设备独立的轮询任务，一台掉线不影响其他设备。</li>
                <li><strong>日志要写文件</strong>：现场出问题后，靠通信日志（发了什么字节、收了什么字节）排查，比猜强一百倍。</li>
            </ul>
        </Prose>
    </ChildContent>
</LessonPage>

@code {
    bool running;
    bool cableOk = true;
    int timeoutMs = 600;
    int maxFail = 3;
    int fail;
    string state = "已停止";
    double? lastValue;
    readonly List<string> log = [];
    CancellationTokenSource? cts;
    DateTime startedAt;

    string StateNote => state switch
    {
        "已停止" => "还没开始。点“开始轮询”，再试着拔网线。",
        "运行中" => "正常：每个周期发一次请求，约 120 毫秒收到应答，更新最新温度。",
        "重连中" => "判定为断线：先关掉旧连接，按退避时间（1、2、4……秒）依次尝试重新连接；线路恢复后自动回到“运行中”。",
        _ => "有读取超时，还没到判定断线的次数，继续轮询。",
    };

    void Toggle()
    {
        running = !running;
        if (running)
        {
            fail = 0;
            startedAt = DateTime.Now;
            _ = Loop((cts = new()).Token);
        }
        else
        {
            cts?.Cancel();
            state = "已停止";
        }
    }

    void ToggleCable()
    {
        cableOk = !cableOk;
        Log(cableOk ? "（网线插回去了）" : "（网线被拔掉了）");
    }

    async Task Loop(CancellationToken token)
    {
        state = "运行中";
        try
        {
            while (!token.IsCancellationRequested)
            {
                if (await ReadOnce(token))
                {
                    fail = 0;
                    state = "运行中";
                    lastValue = Math.Round(24 + Random.Shared.NextDouble() * 2, 1);
                    Log($"读取成功：温度 {lastValue:F1} ℃");
                }
                else
                {
                    fail++;
                    state = "超时中";
                    Log($"读取超时（连续第 {fail} 次，超时 {timeoutMs} 毫秒）");
                    if (fail >= maxFail)
                        await Reconnect(token);
                }
                StateHasChanged();
                await Task.Delay(500, token);
            }
        }
        catch (OperationCanceledException) { }
    }

    /// <summary>模拟一次读取：线路正常时设备约 120 毫秒回应，断线时永远没有回应；超过超时就算失败。</summary>
    async Task<bool> ReadOnce(CancellationToken token)
    {
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(token);
        timeout.CancelAfter(timeoutMs);
        try
        {
            await Task.Delay(cableOk ? 120 : Timeout.Infinite, timeout.Token);
            return true;
        }
        catch (OperationCanceledException) when (!token.IsCancellationRequested)
        {
            return false;
        }
    }

    async Task Reconnect(CancellationToken token)
    {
        state = "重连中";
        Log("连续失败达到上限：判定断线，关闭旧连接，开始重连");
        var delay = 1;
        while (!token.IsCancellationRequested)
        {
            StateHasChanged();
            await Task.Delay(TimeSpan.FromSeconds(delay), token);
            if (cableOk)
            {
                Log($"等待 {delay} 秒后重连成功");
                fail = 0;
                state = "运行中";
                return;
            }
            Log($"等待 {delay} 秒后重连失败，下次等 {Math.Min(delay * 2, 8)} 秒");
            delay = Math.Min(delay * 2, 8);
        }
    }

    void Log(string text)
    {
        log.Add($"[{(DateTime.Now - startedAt).TotalSeconds,5:F1}s] {text}");
        if (log.Count > 12) log.RemoveAt(0);
        StateHasChanged();
    }

    const string LoopCode = """
        async Task PollLoopAsync(CancellationToken token)
        {
            var failures = 0;
            while (!token.IsCancellationRequested)
            {
                try
                {
                    using var timeout = CancellationTokenSource.CreateLinkedTokenSource(token);
                    timeout.CancelAfter(TimeSpan.FromMilliseconds(600));       // 每次读都带超时
                    var registers = await client.ReadAsync(unit: 1, start: 0, count: 3, timeout.Token);
                    Publish(registers);                                         // 把最新值交给界面
                    failures = 0;
                }
                catch (OperationCanceledException) when (!token.IsCancellationRequested)
                {
                    if (++failures >= 3)                                        // 连续失败才判定断线
                    {
                        await ReconnectWithBackoffAsync(token);                 // 1、2、4、8 秒
                        failures = 0;
                    }
                }
                await Task.Delay(500, token);                                   // 轮询周期
            }
        }
        """;

    public void Dispose() => cts?.Cancel();
}
