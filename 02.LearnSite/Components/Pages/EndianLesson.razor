@page "/endian"
@using System.Buffers.Binary
@using System.Globalization
@inherits RuneComponent

@*
    第 2 课：大小端。
      演示 1：输入一个数，看它在内存里的两种排法（同一个字节永远是同一个颜色，换位置一眼就能看出来）
      演示 2：发送方 → 线路 → 接收方，字节一个个飞过去，双方字节序一致/不一致分别会怎样
    字节都是 BinaryPrimitives / 位运算当场算出来的，和 01.CSharpSyntax 练习 12 用的是同一套方法。
*@

<LessonPage Title="大小端：一个数，两种排法">
    <Intro>
        寄存器值 <Code>0x1234</Code> 有两个字节：高字节 <Code>12</Code>、低字节 <Code>34</Code>。通信时先发哪个，两边必须约定好，
        这就是<strong>字节序</strong>。
    </Intro>
    <ChildContent>
        <ConceptGuide>
            <Concept Term="字节序（Endianness）" Analogy="日期写成「2026-11-11」（大的在前）还是「11/11/2026」（小的在前）：信息一样，只是排列顺序约定不同。">
                一个数如果占多个字节（比如 16 位的 <Code>0x1234</Code> 要用 2 个字节），那么<strong>哪个字节先放、哪个后放</strong>就是字节序。
                这个顺序没有对错，只有「双方是否约定一致」。
            </Concept>
            <Concept Term="大端 vs 小端" Analogy="大端像我们读数字：高位（千位）先写；小端是把数字倒着写：低位先写。">
                <strong>大端</strong>：高位字节在前，<Code>0x1234</Code> → <Code>12 34</Code>，网络协议、Modbus、西门子 S7 都用它。
                <strong>小端</strong>：低位字节在前，<Code>0x1234</Code> → <Code>34 12</Code>，x86 / ARM 的 CPU 和 Windows 内存默认用它。
            </Concept>
            <Concept Term="为什么上位机里一定会遇到" Compare="Java 的 ByteBuffer 默认大端；C# 的 BitConverter 按本机（通常小端）。">
                PLC 发过来的是大端字节，你的电脑内存是小端。如果直接把字节「当数字」读，数值就会错：<Code>12 34</Code> 被读成 <Code>0x3412</Code>。
                收到后要按协议约定翻转，或者用 <Code>BinaryPrimitives.ReadUInt16BigEndian</Code> 这类明确指定字节序的方法。
            </Concept>
            <Concept Term="字序（word order）" Analogy="一个 float 占 4 字节，分成两个 16 位寄存器传：是「高寄存器在前」还是「低寄存器在前」，不同厂商不一样，要看设备手册。">
                即使字节序对了，浮点数、32 位整数跨两个寄存器时还要处理<strong>两个字的先后顺序</strong>。常见写法记作 ABCD、CDAB、BADC、DCBA，调试时可以四种都试，看哪种解出来的数值合理。
            </Concept>
        </ConceptGuide>


        <Narration Mood="📅">
            打个比方：同一个日期，中国人写 <strong>2026年11月10日</strong>（从大到小，像<strong>大端</strong>），
            欧洲人写 <strong>10/11/2026</strong>（从小到大，像<strong>小端</strong>）。日期没变，写法不同，
            读的人如果不知道对方的习惯，就会读错。Modbus、西门子 S7 用大端，x86 电脑的内存用小端。
        </Narration>

        <Demo Title="演示 1：一个数，两种排法">
            <Stage>
                <Flex Gap="SpaceScale.Md" Align="ItemAlign.End" Wrap="true">
                    <Field Label="十六进制数值" Error="@(valid ? null : "请输入十六进制数字（0~9、A~F）")">
                        <TextField @bind-Value="hex" @bind-Value:after="Parse"><Prefix>0x</Prefix></TextField>
                    </Field>
                    <ToggleGroup @bind-Value="width" Required="true" aria-label="位宽" @bind-Value:after="Parse">
                        <ToggleItem Value="16">16 位（ushort）</ToggleItem>
                        <ToggleItem Value="32">32 位（uint）</ToggleItem>
                    </ToggleGroup>
                </Flex>
                <Flex Gap="SpaceScale.Sm" Wrap="true">
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => Preset("16", "1234"))">0x1234</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => Preset("16", "000A"))">0x000A（10）</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => Preset("32", "00010002"))">0x00010002</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => Preset("32", "3FC00000"))">0x3FC00000（1.5f）</Button>
                </Flex>
                <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                    <ByteCells Label="大端（先放高位）" Bytes="Big" Ranks="BigRanks" Tags="BigTags" />
                    <ByteCells Label="小端（先放低位）" Bytes="Little" Ranks="LittleRanks" Tags="LittleTags" />
                </Flex>
            </Stage>
            <Side>
                <CodeBlock Code="@Code" Lang="csharp" Copyable="false" />
                <Narration @key="@($"{hex}{width}")" Mood="🎨">
                    看颜色：<strong>同一个字节在两行里颜色相同</strong>（橙色是最高位字节），只是位置反了。
                    大端的内存读起来和我们写数字的顺序一致，小端则是倒过来的。
                </Narration>
            </Side>
        </Demo>

        <Demo Title="演示 2：发过去，读出来">
            <Stage>
                <Paragraph Tone="TextTone.Muted">
                    发送方把上面输入的数（<Code>@("0x" + value.ToString(Format))</Code>）一个字节一个字节发出去，接收方按自己的习惯拼回来。分别选双方的字节序，点"发送"。
                </Paragraph>
                <Flex Gap="SpaceScale.Xl" Wrap="true">
                    <Field Label="发送方">
                        <ToggleGroup @bind-Value="sender" Required="true" aria-label="发送方字节序">
                            <ToggleItem Value="big">大端</ToggleItem>
                            <ToggleItem Value="little">小端</ToggleItem>
                        </ToggleGroup>
                    </Field>
                    <Field Label="接收方">
                        <ToggleGroup @bind-Value="receiver" Required="true" aria-label="接收方字节序">
                            <ToggleItem Value="big">大端</ToggleItem>
                            <ToggleItem Value="little">小端</ToggleItem>
                        </ToggleGroup>
                    </Field>
                </Flex>
                <WireDemo Value="value" Size="Size" SenderBig="@(sender == "big")" ReceiverBig="@(receiver == "big")" />
            </Stage>
            <Side>
                <CodeBlock Code="@WireCode" Lang="csharp" Copyable="false" />
                <Quiz Question="设备按大端发来 00 0A，你按小端去读，会得到多少？"
                      Options="@(new[] { "10", "2560", "0x0A", "257" })" Answer="1"
                      Explain="按小端读，先到的 00 是低字节、后到的 0A 是高字节，拼出 0x0A00，十进制 2560，而不是 10。" />
                <Quiz Question="BitConverter.ToUInt16 在 x86 电脑上默认按什么字节序读？"
                      Options="@(new[] { "大端", "小端" })" Answer="1"
                      Explain="BitConverter 用本机字节序，x86/x64 是小端。直接拿它解析 Modbus（大端）数据会读错，要用 BinaryPrimitives 明确指定。" />
            </Side>
        </Demo>

        <Prose Measure="false">
            <H2>要记住的</H2>
            <ul>
                <li>字节序只影响<strong>多字节的数</strong>（ushort、uint、float……）；单个 byte 没有字节序问题。</li>
                <li>Modbus 的寄存器、S7 的 INT/DINT/REAL 都是大端；<Code>BitConverter</Code> 用的是本机字节序（x86 为小端），直接拿它解析协议数据会读错。</li>
                <li>写协议代码一律用 <Code>BinaryPrimitives</Code>，方法名里写明 <Code>BigEndian</Code> 或 <Code>LittleEndian</Code>，一眼就能核对。</li>
                <li>读到"离谱的数值"，第一个要怀疑的就是字节序。</li>
            </ul>
        </Prose>
    </ChildContent>
</LessonPage>

@code {
    string hex = "1234";
    string width = "16";
    string sender = "big";
    string receiver = "big";
    bool valid = true;
    uint value = 0x1234;

    int Size => width == "32" ? 4 : 2;

    string Format => "X" + Size * 2;

    string BigHex => Convert.ToHexString(Big);

    byte[] Big { get; set; } = [0x12, 0x34];

    byte[] Little { get; set; } = [0x34, 0x12];

    // 颜色：0 = 最高位字节。大端从高到低，小端反过来
    int[] BigRanks => [.. Enumerable.Range(0, Size)];

    int[] LittleRanks => [.. Enumerable.Range(0, Size).Reverse()];

    string[] BigTags => Size == 2 ? ["高字节", "低字节"] : ["最高字节", "", "", "最低字节"];

    string[] LittleTags => Size == 2 ? ["低字节", "高字节"] : ["最低字节", "", "", "最高字节"];

    string Code => Size == 2
        ? $"BinaryPrimitives.WriteUInt16BigEndian(buffer, 0x{value:X4});      // buffer = {BigHex}\n" +
          $"BinaryPrimitives.WriteUInt16LittleEndian(buffer, 0x{value:X4});   // buffer = {Convert.ToHexString(Little)}"
        : $"BinaryPrimitives.WriteUInt32BigEndian(buffer, 0x{value:X8});      // buffer = {BigHex}\n" +
          $"BinaryPrimitives.WriteUInt32LittleEndian(buffer, 0x{value:X8});   // buffer = {Convert.ToHexString(Little)}";


    // 接收方按自己选的字节序读取时用的代码
    string WireCode
    {
        get
        {
            var type = Size == 2 ? "UInt16" : "UInt32";
            var digits = Size == 2 ? "X4" : "X8";
            var senderOrder = sender == "big" ? "Big" : "Little";
            var receiverOrder = receiver == "big" ? "Big" : "Little";
            return string.Join("\n",
                $"// 发送方",
                $"BinaryPrimitives.Write{type}{senderOrder}Endian(buffer, 0x{value.ToString(digits)});",
                "// 接收方",
                $"var value = BinaryPrimitives.Read{type}{receiverOrder}Endian(received);");
        }
    }

    protected override void OnInitialized() => Parse();

    void Preset(string newWidth, string newHex)
    {
        width = newWidth;
        hex = newHex;
        Parse();
    }

    // 输入或位宽变化时重新算：数值与两种排法
    void Parse()
    {
        valid = uint.TryParse(hex, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var parsed);
        value = Size == 2 ? parsed & 0xFFFF : parsed;

        Big = new byte[Size];
        Little = new byte[Size];
        if (Size == 2)
        {
            BinaryPrimitives.WriteUInt16BigEndian(Big, (ushort)value);
            BinaryPrimitives.WriteUInt16LittleEndian(Little, (ushort)value);
        }
        else
        {
            BinaryPrimitives.WriteUInt32BigEndian(Big, value);
            BinaryPrimitives.WriteUInt32LittleEndian(Little, value);
        }
    }
}
