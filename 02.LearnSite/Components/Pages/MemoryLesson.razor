@page "/memory"
@inherits RuneComponent

@*
    第 3 课：值类型与引用类型。两个并排的演示，同样的三步操作（创建、赋值、修改），结果完全不同：
      struct：赋值是"复制一份"，两个变量各管各的
      class ：赋值是"多一个指向同一个对象的引用"，改一个另一个跟着变
    "栈上的变量"与"堆上的对象"这样画是教学简化，不是真实内存布局。
*@

<Container Size="ContainerSize.Lg" Padding="SpaceScale.None">
    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Xl">

        <Prose Measure="false">
            <H1>值类型 vs 引用类型</H1>
            <Paragraph>
                <Code>int</Code>、<Code>double</Code>、<Code>struct</Code> 这类<strong>值类型</strong>，变量里直接装着数据，赋值就是复制一份。
                <Code>class</Code>、数组、<Code>string</Code> 这类<strong>引用类型</strong>，变量里装的是"指向对象的地址"，赋值只是多了一个指向同一个对象的地址。
            </Paragraph>
        </Prose>

        <Grid MinItemWidth="CssLength.Rem(22)" Gap="SpaceScale.Lg">
            @* ---------------- struct ---------------- *@
            <Card>
                <Header><Strong>struct（值类型）</Strong></Header>
                <ChildContent>
                    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                        <Flex Gap="SpaceScale.Sm" Wrap="true">
                            <Button Variant="ButtonVariant.Soft" Disabled="@structCopied" @onclick="CopyStruct">s2 = s1</Button>
                            <Button Variant="ButtonVariant.Soft" Disabled="@(!structCopied)" @onclick="ChangeStruct">s2.X = 99</Button>
                            <Button Variant="ButtonVariant.Ghost" Tone="Tone.Neutral" @onclick="ResetStruct">重来</Button>
                        </Flex>
                        <Flex Gap="SpaceScale.Md" Wrap="true">
                            <Slot Name="s1" Data="@($"X = {s1X}")" />
                            @if (structCopied)
                            {
                                <Slot Name="s2" Data="@($"X = {s2X}")" Changed="@(s2X != s1X)" />
                            }
                        </Flex>
                        <Paragraph Size="Size.Sm" Tone="TextTone.Muted">@StructNote</Paragraph>
                    </Flex>
                </ChildContent>
            </Card>

            @* ---------------- class ---------------- *@
            <Card>
                <Header><Strong>class（引用类型）</Strong></Header>
                <ChildContent>
                    <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Md">
                        <Flex Gap="SpaceScale.Sm" Wrap="true">
                            <Button Variant="ButtonVariant.Soft" Disabled="@classCopied" @onclick="CopyClass">c2 = c1</Button>
                            <Button Variant="ButtonVariant.Soft" Disabled="@(!classCopied)" @onclick="ChangeClass">c2.X = 99</Button>
                            <Button Variant="ButtonVariant.Ghost" Tone="Tone.Neutral" @onclick="ResetClass">重来</Button>
                        </Flex>
                        <Flex Direction="LayoutDirection.Column" Gap="SpaceScale.Sm">
                            <Small Tone="TextTone.Muted">栈：变量，里面是对象的地址</Small>
                            <Flex Gap="SpaceScale.Md" Wrap="true">
                                <Slot Name="c1" Data="→ 对象 #1" />
                                @if (classCopied)
                                {
                                    <Slot Name="c2" Data="→ 对象 #1" />
                                }
                            </Flex>
                            <Small Tone="TextTone.Muted">堆：对象本身，只有一个</Small>
                            <Flex Gap="SpaceScale.Md" Wrap="true">
                                <Slot Name="对象 #1" Data="@($"X = {objectX}")" Changed="@(objectX != 1)" />
                            </Flex>
                        </Flex>
                        <Paragraph Size="Size.Sm" Tone="TextTone.Muted">@ClassNote</Paragraph>
                    </Flex>
                </ChildContent>
            </Card>
        </Grid>

        <CodeBlock Code="@Code" Lang="csharp" Highlight="false" Copyable="false" Title="你刚才执行的代码" />

        <Prose Measure="false">
            <H2>要记住的</H2>
            <ul>
                <li>值类型赋值、传参都是<strong>复制</strong>；引用类型赋值、传参复制的是<strong>引用</strong>，两个变量指向同一个对象。</li>
                <li>方法里修改传进来的对象，调用方能看到（它们是同一个对象）；修改传进来的 int / struct，调用方看不到——除非用 <Code>ref</Code>。</li>
                <li><Code>string</Code> 是引用类型，但它<strong>不可变</strong>：每次"修改"都产生新字符串，所以表现得像值类型。</li>
                <li>record 默认是引用类型，但 <Code>==</Code> 比较的是内容；<Code>record struct</Code> 才是值类型。</li>
            </ul>
        </Prose>
    </Flex>
</Container>

@code {
    // ---- struct ----
    int s1X = 1;
    int s2X;
    bool structCopied;

    void CopyStruct() { s2X = s1X; structCopied = true; log.Add("var s2 = s1;   // 复制了一份"); }

    void ChangeStruct() { s2X = 99; log.Add("s2.X = 99;      // 只改了 s2"); }

    void ResetStruct() { structCopied = false; s2X = 0; log.RemoveAll(l => l.Contains("s2")); }

    string StructNote => !structCopied ? "先点\"s2 = s1\"。" : s2X == 99 ? "s1 还是 1：s2 是独立的一份。" : "s2 是 s1 的一份拷贝，现在两份内容相同。";

    // ---- class ----
    int objectX = 1;
    bool classCopied;

    void CopyClass() { classCopied = true; log.Add("var c2 = c1;   // 没有新对象，只是多了一个引用"); }

    void ChangeClass() { objectX = 99; log.Add("c2.X = 99;      // 改的是同一个对象"); }

    void ResetClass() { classCopied = false; objectX = 1; log.RemoveAll(l => l.Contains("c2")); }

    string ClassNote => !classCopied ? "先点\"c2 = c1\"。" : objectX == 99 ? "c1 和 c2 指向同一个对象，通过 c2 改，c1 看到的也变了。" : "c1 和 c2 现在指向同一个对象 #1。";

    // ---- 代码记录 ----
    readonly List<string> log = [];

    string Code => string.Join("\n", ["var s1 = new PointStruct { X = 1 };", "var c1 = new PointClass { X = 1 };", .. log]);
}
