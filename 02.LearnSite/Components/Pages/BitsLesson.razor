@page "/bits"
@inherits RuneComponent

@*
    第 1 课：位与字节。三个演示 + 三道小测验：
      1. 一个字节：点 8 个位格，看"权重相加"变成十进制，同时看有符号、十六进制、二进制
      2. 位运算：竖式对齐，每一列下面写出怎么算的；移位会告诉你掉出去了什么
      3. Flags：设备面板上的 4 盏报警灯，点灯 = 状态字节里一位翻转（对应 01.CSharpSyntax 练习 12）
    页面上显示的数字、代码都是 C# 当场算出来的。代码块有语法高亮（Rune 自带，离线可用）。
*@

<LessonPage Title="位与字节">
    <Intro>
        计算机里一切都是 0 和 1。一个 <Code>byte</Code> 有 8 个位，像 8 个<strong>开关</strong>：每个开关有自己的"分值"
        （最右边 1 分，往左依次 2、4、8……128 分），<strong>开着的开关分值加起来，就是这个字节的值</strong>。
    </Intro>
    <ChildContent>
        <ConceptGuide>
            <Concept Term="位（bit）与字节（byte）" Analogy="一个位就是一个只有「开 / 关」两种状态的开关；8 个开关排成一排，就是一个字节。">
                计算机里所有东西最终都是 0 和 1。一个位只能是 0 或 1；<strong>8 个位 = 1 个字节</strong>，能表示 0~255 共 256 种组合。
                PLC 里一个「状态字」常常只是一个字节：每一位代表一个独立的开关（有没有报警、电机是否在转）。
            </Concept>
            <Concept Term="位运算：与、或、异或、取反、移位" Analogy="与（&）像「两个开关都要开」，或（|）像「有一个开就行」，异或（^）像「两个不一样才亮」，取反（~）是把每个开关反过来。" Compare="Java 和 JS 的位运算符完全一样；区别是 C# 有专门的 byte 类型，Java 的 byte 是有符号的。">
                位运算是<strong>对每一位分别运算</strong>，而不是把整个数当数字算。左移 <Code>&lt;&lt; n</Code> 相当于把所有位向左挪 n 格，空出来的补 0，数值大致乘以 2 的 n 次方。
            </Concept>
            <Concept Term="掩码（mask）" Analogy="像一张只在某些位置挖了洞的纸盖在数据上：洞下面的位你能看到、能改，其余的位被遮住不受影响。">
                想只读第 3 位，就用 <Code>value &amp; 0b0000_1000</Code>：别的位都被清成 0，只留下第 3 位。想只把第 3 位置 1 用 <Code>|</Code>，清 0 用 <Code>&amp; ~mask</Code>，翻转用 <Code>^</Code>。
            </Concept>
            <Concept Term="[Flags] 枚举" Analogy="给每个开关起个名字，再允许把几个名字「拼」在一起，比如 Overheat | Offline 表示两个报警同时发生。">
                枚举每个成员占一位（1、2、4、8……），一个变量就能同时记住好几个状态；判断有没有某个状态用 <Code>HasFlag</Code> 或 <Code>(value &amp; X) != 0</Code>。
            </Concept>
        </ConceptGuide>


        <Demo Title="演示 1：拨动 8 个开关">
            <Stage>
                <BitRow Label="byte" @bind-Value="single" />
                <BitSum Value="single" />
                <Flex Gap="SpaceScale.Sm" Wrap="true">
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => single = 0)">清零</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => single = 255)">全部置 1</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => single = 0b1000_0000)">只有最高位</Button>
                    <Button Variant="ButtonVariant.Soft" Tone="Tone.Neutral" @onclick="@(() => single = 0b0000_1010)">0b0000_1010</Button>
                </Flex>
                <Grid MinItemWidth="CssLength.Rem(11)" Gap="SpaceScale.Sm">
                    <Readout Title="byte（无符号 0~255）" Value="@single.ToString()" />
                    <Readout Title="sbyte（有符号 -128~127）" Value="@unchecked((sbyte)single).ToString()" />
                    <Readout Title="十六进制" Value="@($"0x{single:X2}")" />
                    <Readout Title="二进制" Value="@Binary(single)" />
                </Grid>
            </Stage>
            <Side>
                <CodeBlock Code="@SingleCode" Lang="csharp" Copyable="false" />
                <Narration @key="single" Mood="@SingleNote.Emoji">@SingleNote.Text</Narration>
                <Quiz Question="0b0000_0110 是多少？" Options="@(new[] { "4", "6", "8", "12" })" Answer="1"
                      Explain="第 1 位（权重 2）和第 2 位（权重 4）是 1，2 + 4 = 6。" />
            </Side>
        </Demo>

        <Demo Title="演示 2：位运算的“竖式”">
            <Stage>
                <ToggleGroup @bind-Value="op" Required="true" aria-label="运算">
                    <ToggleItem Value="or">| 或</ToggleItem>
                    <ToggleItem Value="and">&amp; 与</ToggleItem>
                    <ToggleItem Value="xor">^ 异或</ToggleItem>
                    <ToggleItem Value="not">~ 取反</ToggleItem>
                    <ToggleItem Value="shl">&lt;&lt; 左移</ToggleItem>
                    <ToggleItem Value="shr">&gt;&gt; 右移</ToggleItem>
                </ToggleGroup>
                @if (op is "shl" or "shr")
                {
                    <Field Label="@($"移动 {shift} 位")">
                        <Slider TValue="int" @bind-Value="shift" Min="1" Max="7" />
                    </Field>
                }
                <BitMath @bind-A="a" @bind-B="b" Op="@op" Shift="@shift" />
            </Stage>
            <Side>
                <CodeBlock Code="@CodeLine" Lang="csharp" Copyable="false" />
                <Narration @key="op" Mood="@Rule.Emoji">@Rule.Text</Narration>
                <Quiz Question="0b1100 & 0b1010 等于多少？" Options="@(new[] { "0b1000", "0b1010", "0b1100", "0b1110" })" Answer="0"
                      Explain="& 要两个位都是 1 才得 1：1100 和 1010 只有最高位同时是 1，所以结果是 1000。" />
            </Side>
        </Demo>

        <Demo Title="演示 3：设备面板上的 4 盏报警灯（Flags）">
            <Stage>
                <AlarmLamps @bind-Values="alarms" />
                <BitRow Label="状态字节" Value="AlarmByte" ReadOnly="true" Captions="alarmCaptions" />
            </Stage>
            <Side>
                <CodeBlock Code="@AlarmCode" Lang="csharp" Copyable="false" />
                <Narration Mood="📟">
                    点一盏灯，状态字节里对应的那一位就翻转：灯亮 = 这一位是 1。设备把 4 个报警塞进<strong>一个字节</strong>发给你，
                    你收到后逐位检查，就知道哪几个报警正在发生。打开一个报警用 <Code>|=</Code>，关闭用 <Code>&amp;= ~</Code>。
                </Narration>
                <Quiz Question="想让 Offline（第 2 位）一定变成 0，不管它原来是 0 还是 1，用哪个？"
                      Options="@(new[] { "alarm |= Alarm.Offline", "alarm &= ~Alarm.Offline", "alarm ^= Alarm.Offline" })" Answer="1"
                      Explain="~Offline 是“只有第 2 位是 0、其余全是 1”，和 alarm 做 & 就把第 2 位清 0、其他位不变。| 是置 1，^ 是翻转（原来是 0 反而会变成 1）。" />
            </Side>
        </Demo>

        <Prose Measure="false">
            <H2>要记住的四句话</H2>
            <ul>
                <li><strong>byte 是 0~255，没有符号</strong>；sbyte 才有符号。Java 的 byte 是有符号的，这是两门语言最大的差别之一。</li>
                <li><strong>置位用 <Code>|</Code></strong>，<strong>清除用 <Code>&amp; ~</Code></strong>，<strong>翻转用 <Code>^</Code></strong>，<strong>检测用 <Code>&amp;</Code></strong>。</li>
                <li><strong>左移一位 = 乘 2，右移一位 = 除 2</strong>（整数）；移出 8 位的部分会丢掉。</li>
                <li>位运算的结果在 C# 里是 <Code>int</Code>，赋回 <Code>byte</Code> 要强转，强转会静默截断高位。</li>
            </ul>
        </Prose>
    </ChildContent>
</LessonPage>

@code {
    // ---- 演示 1 ----
    byte single = 0b0000_1010;

    string SingleCode =>
        $"byte value = {Literal(single)};   // = {single}\n" +
        $"sbyte signed = unchecked((sbyte)value);   // = {unchecked((sbyte)single)}\n" +
        $"string hex = value.ToString(\"X2\");   // = {single:X2}";

    (string Emoji, string Text) SingleNote => single switch
    {
        0 => ("😴", "8 个开关全关着，值是 0。点一格试试。"),
        255 => ("💥", "8 个开关全开，是 byte 能装的最大值 255；再加 1 就装不下，会溢出回到 0。"),
        128 => ("🧭", "只有最高位开着：作为 byte 是 128，作为 sbyte 却是 -128。有符号数里最高位叫\"符号位\"，开着就是负数。"),
        _ => ("🧮", $"开着的开关分值加起来就是 {single}。每多开一个，值就多加这一位的分值。"),
    };

    // ---- 演示 2 ----
    string op = "or";
    byte a = 0b0000_1100;
    byte b = 0b0000_1010;
    int shift = 1;

    string CodeLine => $"byte result = (byte)({Expression});   // 结果 {BitMath.Compute(op, a, b, shift)}（{Literal(BitMath.Compute(op, a, b, shift))}）";

    string Expression => op switch
    {
        "or" => $"{Literal(a)} | {Literal(b)}",
        "and" => $"{Literal(a)} & {Literal(b)}",
        "xor" => $"{Literal(a)} ^ {Literal(b)}",
        "not" => $"~{Literal(a)}",
        "shl" => $"{Literal(a)} << {shift}",
        "shr" => $"{Literal(a)} >> {shift}",
        _ => "",
    };

    (string Emoji, string Text) Rule => op switch
    {
        "or" => ("🔓", "或：两个位只要有一个是 1，结果就是 1。常用来\"置位\"——把想开的开关打开，其他的不动。"),
        "and" => ("🔍", "与：两个位都是 1，结果才是 1。常用来\"检测\"或\"屏蔽\"——只留下想看的那几位。"),
        "xor" => ("🔀", "异或：两个位不一样，结果是 1。常用来\"翻转\"；任何数异或自己都得 0。"),
        "not" => ("🔄", "取反：0 变 1，1 变 0。~ 常和 & 配合清除某一位：x &= ~flag。"),
        "shl" => ("⬅️", "左移：整体向左平移，右边补 0。每移一位相当于乘 2。"),
        "shr" => ("➡️", "右移：整体向右平移，左边补 0（对 byte 来说）。每移一位相当于除以 2 并舍去余数。"),
        _ => ("", ""),
    };

    // ---- 演示 3 ----
    IReadOnlyList<string> alarms = ["Overheat", "Offline"];

    static readonly IReadOnlyDictionary<int, string> alarmCaptions = AlarmLamps.Defs.ToDictionary(d => d.Bit, d => d.Label);

    byte AlarmByte => (byte)AlarmLamps.Defs.Where(d => alarms.Contains(d.Name)).Sum(d => 1 << d.Bit);

    string AlarmCode => alarms.Count == 0
        ? "var alarm = Alarm.None;   // 0"
        : $"var alarm = {string.Join(" | ", AlarmLamps.Defs.Where(d => alarms.Contains(d.Name)).Select(d => $"Alarm.{d.Name}"))};   // 值 = {AlarmByte}，二进制 {Literal(AlarmByte)}";

    // ---- 小工具 ----
    static string Binary(byte value) => Convert.ToString(value, 2).PadLeft(8, '0').Insert(4, "_");

    static string Literal(byte value) => $"0b{Binary(value)}";
}
