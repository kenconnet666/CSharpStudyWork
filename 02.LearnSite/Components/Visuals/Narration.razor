@*
    解说气泡：一两句大白话，告诉你"刚才发生了什么、为什么"。
    用的是 Rune 的 Alert（提示条），图标是 Lucide，色调随"心情"变：成功绿、出错红、提醒黄、其余蓝。
    Mood 是一个短键（见 Mood.cs）。内容变化时气泡会淡入一下（调用方给它 @key 即可），让注意力回到文字上。
*@
@namespace LearnSite.Components.Visuals
@inherits RuneComponent

<Alert Tone="@look.Tone" Icon="@look.Icon" Sx="Appear">@ChildContent</Alert>

@code {
    /// <summary>提示的类型键，如 "💡"、"✅"、"💥"，对应的图标和色调见 Mood.cs。</summary>
    [Parameter] public string Mood { get; set; } = "💡";

    /// <summary>解说的文字。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    (IconData Icon, Tone Tone) look => LearnSite.Components.Mood.For(Mood);

    static Style Appear => Css.Define(static () => new Style
    {
        Keyframes = Fade,
        AnimationDuration = "0.3s",
        AnimationTimingFunction = Easings.Enter,
    });

    static Keyframes Fade => Css.Define(static () => new Keyframes
    {
        ["from"] = new() { Opacity = 0, Transform = "translateY(4px)" },
        ["to"] = new() { Opacity = 1, Transform = "none" },
    });
}
