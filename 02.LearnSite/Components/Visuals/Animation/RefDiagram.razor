@*
    引用类型的示意图：上面是"栈"里的变量，箭头指向下面"堆"里的同一个对象。
    变量只有一个箭头时是 c1；再来一个变量复制引用（c2 = c1）时，第二个箭头指向的还是同一个对象。
    用固定大小（320×210 像素）的画布和绝对定位，箭头坐标就不会随窗口缩放错位。
*@
@namespace LearnSite.Components.Visuals
@inherits RuneComponent

<div style="position:relative;width:320px;max-width:100%;height:210px">
    <svg width="320" height="210" viewBox="0 0 320 210" style="position:absolute;inset:0;pointer-events:none;color:@Tones.Accent.Solid" aria-hidden="true">
        <defs>
            <marker id="ref-arrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
                <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
            </marker>
        </defs>
        <line x1="64" y1="68" x2="136" y2="136" stroke="currentColor" stroke-width="2" marker-end="url(#ref-arrow)" />
        @if (SecondReference)
        {
            <line @key="1" x1="256" y1="68" x2="184" y2="136" stroke="currentColor" stroke-width="2" marker-end="url(#ref-arrow)" />
        }
    </svg>
    <div style="position:absolute;left:8px;top:6px;width:112px"><Slot Name="c1（变量，在栈里）" Data="→ 对象 #1" /></div>
    @if (SecondReference)
    {
        <div @key="2" style="position:absolute;left:200px;top:6px;width:112px"><Slot Name="c2（变量，在栈里）" Data="→ 对象 #1" /></div>
    }
    <div style="position:absolute;left:104px;top:142px;width:112px"><Slot Name="对象 #1（在堆里）" Data="@ObjectData" Changed="@ObjectChanged" /></div>
</div>

@code {
    /// <summary>是否已经有第二个变量指向同一个对象。</summary>
    [Parameter] public bool SecondReference { get; set; }

    /// <summary>对象里装的内容，如 "X = 1"。</summary>
    [Parameter] public string ObjectData { get; set; } = "";

    /// <summary>对象刚被修改过。</summary>
    [Parameter] public bool ObjectChanged { get; set; }
}
